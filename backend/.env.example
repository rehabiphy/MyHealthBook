PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/myhealthbook

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Gmail: use an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-char-app-password

CORS_ORIGIN=*

# Must match the scheme registered in AndroidManifest.xml / Info.plist.
APP_SCHEME=myhealthbook

# The domain this backend is deployed at — used to build the email
# verification link (https://<WEB_BASE_URL>/verify?...). Must match
# the host registered in assetlinks.json / the AndroidManifest App
# Link intent-filter.
WEB_BASE_URL=https://myhealthbook.rehabiphy.com

# AI Coach — leave OPENAI_API_KEY blank until you add a real key; the
# coach endpoint returns a clear "not configured" error until then.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Which AI answers coach, insights, assistant, health tips and report
# reading: openai (default) or bedrock (Amazon Bedrock, using the AWS
# credentials below). Switching is this one line + a restart.
AI_PROVIDER=openai
# Optional overrides; leave blank for the defaults.
# Defaults: amazon.nova-pro-v1:0 for chat and documents,
# amazon.nova-lite-v1:0 as the fallback if a request fails.
# Any Bedrock model ID works here (e.g. a Claude model once the
# account has Anthropic access) — no code change needed.
# BEDROCK_REGION defaults to AWS_REGION.
BEDROCK_REGION=
BEDROCK_MODEL=
BEDROCK_DOCUMENT_MODEL=
BEDROCK_FALLBACK_MODEL=

# Amazon Textract scans uploaded reports (text, tables, form fields)
# before the AI reads them. Needs S3_BUCKET/AWS_REGION and IAM access.
TEXTRACT_ENABLED=false

# Medicine search on Amazon OpenSearch Service (typo-tolerant, best
# match first, same-salt alternatives). OPENSEARCH_ENDPOINT is the
# domain's VPC endpoint; load it with npm run index:meds. With
# SEARCH_ENABLED=false (or if OpenSearch is down) the MongoDB search is used.
SEARCH_ENABLED=false
OPENSEARCH_ENDPOINT=

# Daily AI health tip push (src/jobs/healthTips.js), ~10 am in each
# user's timezone. Turn on ONLY on the one production server — a dev
# server pointed at the real database would tip every real user too.
HEALTH_TIPS_ENABLED=false

# Google Sign-In — the WEB OAuth client ID from Google Cloud Console
# (also used as the frontend's GoogleSignin webClientId). An Android
# OAuth client also needs registering there against package name
# com.myhealthbook + the app's signing certificate SHA-1.
GOOGLE_CLIENT_ID=

# PayU payment gateway — leave PAYU_KEY/PAYU_SALT blank until you have
# real sandbox/live credentials; the checkout endpoint returns a clear
# "not configured" error until then. PAYU_MODE picks test.payu.in vs
# secure.payu.in — a config toggle, never hardcode a fallback key/salt.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=test

# Firebase Admin SDK — paste the service account JSON's full contents
# here, minified to one line (e.g. `node -e "console.log(JSON.stringify(require('./service-account.json')))"`).
# Lets this deploy without ever uploading the JSON file itself. Leave
# blank to fall back to the local .json file next to this one (local
# dev convenience only).
FIREBASE_SERVICE_ACCOUNT=
